---
import Base from '../layouts/Base.astro'
import { content, isRtl, langs, paths } from '../i18n/content'
const en = content.en.notFound
const rest = langs.filter((l) => l !== 'en')
---

<Base lang="en" title="404 — Veyra Studio" noindex>
  <main class="not-found" id="main">
    <svg class="nf-thread" viewBox="0 0 400 120" aria-hidden="true">
      <path d="M0 60 C 60 10, 120 110, 180 60 S 300 10, 330 70 Q 350 110, 372 92" />
    </svg>
    <h1>{en.title}</h1>
    <p>{en.body}</p>
    <p><a class="btn btn-solid" href="/">{en.home}</a></p>
    <div class="nf-others">
      {
        rest.map((l) => (
          <div lang={l} dir={isRtl(l) ? 'rtl' : 'ltr'} class="nf-alt">
            <h2>{content[l].notFound.title}</h2>
            <p>{content[l].notFound.body}</p>
            <p><a class="btn btn-line" href={paths[l]}>{content[l].notFound.home}</a></p>
          </div>
        ))
      }
    </div>
  </main>
</Base>
