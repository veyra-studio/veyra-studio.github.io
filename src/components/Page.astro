---
import { content, email, isRtl, langs, links, mailto, paths, scriptLang, type Lang } from '../i18n/content'
import { localNumber } from '../i18n/numerals'
import Logo from './Logo.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = content[lang]
const others = langs.filter((l) => l !== lang)
const digits = (s: string) => localNumber(lang, s)
const arrowFor = (l: Lang) => (isRtl(l) ? '←' : '→')
const arrow = arrowFor(lang)
const two = (n: number) => digits(String(n).padStart(2, '0'))
const dirOf = (l: Lang) => (isRtl(l) ? 'rtl' : 'ltr')
const mail = mailto(t.contact.subject)
const code = `import {
  createStage,
  horizontal,
  scenePresets,
  splitText,
} from '@veyra/core'

const stage = createStage()        // one loop, smooth native scroll
const title = splitText('h1', { type: 'chars' })

stage.scene('#story', {
  ...scenePresets.pinned,          // pinned with CSS sticky
  timeline: stage.timeline().fromTo(
    title.chars,
    { y: '1em', opacity: 0 },
    { y: '0em', opacity: 1 },
    { stagger: 0.03 },
  ),
})

// Sideways, in reading order (rightward in Persian)
stage.use(horizontal('#gallery', { snap: true }))`
---

<a class="skip-link" href="#main">{t.skip}</a>

<header class="nav" data-nav>
  <a class="nav-mark" href={paths[lang]} aria-label={t.nav.home}>
    <Logo />
    <span class="nav-mark-text">{t.hero.wordmark}</span>
  </a>
  <nav class="nav-links" aria-label={t.nav.menu}>
    <a href="#engine">{t.nav.engine}</a>
    <a href="#work">{t.nav.work}</a>
    <a href="#studio">{t.nav.studio}</a>
    <a href="#contact" class="nav-contact">{t.nav.contact}</a>
    <a href={links.core} class="nav-ext">{t.nav.source}<span aria-hidden="true"> ↗</span></a>
  </nav>
  <nav class="lang-switch" aria-label={t.nav.languages}>
    {
      langs.map((l) =>
        l === lang ? (
          <span class="ls-item is-current" lang={l} aria-current="page" title={content[l].langName}>
            <span aria-hidden="true">{content[l].langShort}</span>
            <span class="visually-hidden">{content[l].langName}</span>
          </span>
        ) : (
          <a class="ls-item" href={paths[l]} hreflang={l} lang={l} data-lang-switch={l} title={content[l].langName}>
            <span aria-hidden="true">{content[l].langShort}</span>
            <span class="visually-hidden">{content[l].langName}</span>
          </a>
        ),
      )
    }
  </nav>
</header>

<main id="main">
  <section class="hero" id="top" data-scene="hero">
    <canvas class="veil" aria-hidden="true"></canvas>
    <div class="hero-grid">
      <p class="eyebrow hero-eyebrow">{t.hero.eyebrow}</p>
      <h1 class="wordmark" data-wordmark>{t.hero.wordmark}</h1>
      <p class="wordmark-alt" lang={t.hero.wordmarkAltLang} aria-hidden="true">{t.hero.wordmarkAlt}</p>
      <div class="hero-foot">
        <p class="hero-lead">{t.hero.lead}</p>
        <div class="hero-ctas">
          <a class="btn btn-solid" href={links.abali}>{t.hero.ctaWork}<span aria-hidden="true"> ↗</span></a>
          <a class="btn btn-line" href="#engine">{t.hero.ctaEngine}<span aria-hidden="true"> ↓</span></a>
        </div>
      </div>
      <span class="hero-scroll" aria-hidden="true"><i></i><span class="hs-text">{t.hero.scroll}</span></span>
    </div>
  </section>

  <section class="statement" id="statement" data-scene="statement">
    <p class="eyebrow">{t.statement.kicker}</p>
    <h2 class="statement-lines" data-statement>
      {t.statement.lines.map((line, i) => <span class={`st-line st-${i}`}>{line}</span>)}
    </h2>
    <p class="statement-note">{t.statement.note}</p>
  </section>

  <section class="engine" id="engine">
    <header class="section-head">
      <p class="eyebrow">{t.engine.kicker}</p>
      <h2 class="section-title">{t.engine.title}</h2>
      <p class="section-intro">{t.engine.intro}</p>
    </header>
    <ol class="caps">
      {
        t.engine.caps.map((cap) => (
          <li class={`cap cap-${cap.id}`} data-cap={cap.id}>
            <div class="cap-text">
              <span class="cap-no">{cap.no}</span>
              <h3 class="cap-title">{cap.title}</h3>
              <p class="cap-body">{cap.body}</p>
            </div>
            <div class="demo" aria-hidden={cap.id === 'webgl' ? undefined : 'true'}>
              {cap.id === 'loop' && (
                <div class="demo-loop">
                  <canvas class="spark" data-spark />
                  <dl class="readout">
                    <div><dt>{t.engine.live.fps}</dt><dd data-fps>—</dd></div>
                    <div><dt>{t.engine.live.frame}</dt><dd data-frame>—</dd></div>
                    <div><dt>{t.engine.live.refresh}</dt><dd data-refresh>—</dd></div>
                  </dl>
                </div>
              )}
              {cap.id === 'motion' && (
                <div class="demo-spring" data-spring>
                  <canvas class="spring-trail" data-trail />
                  <span class="spring-anchor" />
                  <span class="spring-dot" data-dot data-label={t.engine.springLabel} />
                  <span class="demo-hint">{cap.hint}</span>
                </div>
              )}
              {cap.id === 'scroll' && (
                <div class="demo-scroll" data-scroll-demo>
                  <span class="ds-label">{t.engine.scrollProgress}</span>
                  <output class="ds-value" data-scroll-value>{digits('0.00')}</output>
                  <span class="ds-bar"><i data-scroll-bar /></span>
                </div>
              )}
              {cap.id === 'type' && (
                <div class="demo-type" data-type-demo>
                  <div class="dt-row">
                    <span class="dt-tag">{t.engine.typeNaive}</span>
                    <p class="dt-sample" lang={scriptLang(t.engine.typeSample)} dir="rtl" data-type-naive>{t.engine.typeSample}</p>
                  </div>
                  <div class="dt-row">
                    <span class="dt-tag dt-tag-on">{t.engine.typeVeyra}</span>
                    <p class="dt-sample" lang={scriptLang(t.engine.typeSample)} dir="rtl" data-type-veyra>{t.engine.typeSample}</p>
                  </div>
                </div>
              )}
              {cap.id === 'quality' && (
                <div class="demo-quality">
                  <div class="dq-meter"><i data-quality-bar /></div>
                  <dl class="readout">
                    <div><dt>{t.engine.live.quality}</dt><dd data-tier data-tiers={JSON.stringify(t.engine.live.tiers)}>—</dd></div>
                    <div><dt>{t.engine.live.dpr}</dt><dd data-dpr>—</dd></div>
                  </dl>
                </div>
              )}
              {cap.id === 'webgl' && (
                <a class="demo-webgl" href={links.abali}>
                  <span class="dw-label" aria-hidden="true"><span class="dw-oval" lang="fa">دوغ آبعلی</span></span>
                  <span class="dw-cta">{t.work.cta}<span aria-hidden="true"> ↗</span></span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="next" id="new" aria-labelledby="next-title">
    <div class="next-pin">
      <div class="next-head">
        <p class="eyebrow">{t.next.kicker}</p>
        <p class="next-count" aria-hidden="true"><span data-next-count>{two(1)}</span> / {two(t.next.panels.length + 1)}</p>
      </div>
      <ol class="next-track" data-next-track>
        <li class="np np-intro" data-panel="intro">
          <div class="np-meta">
            <span class="np-index">{two(1)}</span>
            <code class="np-api" dir="ltr" lang="en">horizontal()</code>
          </div>
          <h2 class="np-headline" id="next-title">{t.next.title}</h2>
          <div class="np-intro-text">
            <p>{t.next.intro}</p>
            <p class="np-muted">{t.next.direction}</p>
          </div>
          <span class="np-cue" aria-hidden="true">{t.hero.scroll} <i>{arrow}</i></span>
        </li>
        {
          t.next.panels.map((panel, i) => (
            <li class={`np np-${panel.id}`} data-panel={panel.id}>
              <div class="np-meta">
                <span class="np-index">{two(i + 2)}</span>
                <code class="np-api" dir="ltr" lang="en">{panel.api}</code>
              </div>
              <div class={`np-demo np-demo-${panel.id}`} data-demo={panel.id}>
                {panel.id === 'kashida' && (
                  <>
                    <div class="kd-stage">
                      <p class="kd-sample" lang={scriptLang(t.next.kashidaSample)} dir="rtl">
                        <span class="visually-hidden">{t.next.kashidaSample}</span>
                        <span aria-hidden="true" data-kashida>{t.next.kashidaSample.split(' ').map((word, j) => (j ? <><br />{word}</> : word))}</span>
                      </p>
                    </div>
                    <div class="kd-control">
                      <label for="kd-range">{t.next.kashidaLabel}</label>
                      <input id="kd-range" type="range" min="0" max="8" step="1" value="0" data-kashida-range />
                      <output for="kd-range" data-kashida-level>{digits('0')}</output>
                    </div>
                  </>
                )}
                {panel.id === 'drag' && (
                  <div class="dg-viewport">
                    <div class="dg-track" tabindex="0" role="group" aria-label={t.next.dragLabel} data-drag-track>
                      {t.next.dragCards.map((word, j) => (
                        <div class="dg-card">
                          <span class="dg-no">{two(j + 1)}</span>
                          <strong>{word}</strong>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                {panel.id === 'flip' && (
                  <>
                    <ul class="fl-grid" aria-hidden="true" data-flip-grid>
                      {Array.from({ length: 12 }, (_, j) => (
                        <li class:list={[{ 'is-big': j === 0, 'is-light': j % 5 === 2 }]}>{digits(String(j + 1))}</li>
                      ))}
                    </ul>
                    <button type="button" class="np-btn" data-flip-shuffle>{t.next.flipShuffle}</button>
                  </>
                )}
                {panel.id === 'pointer' && (
                  <>
                    <div class="pt-card" aria-hidden="true" data-tilt>
                      <span class="pt-card-api" dir="ltr" lang="en">tilt()</span>
                      <strong>{t.next.tiltCard}</strong>
                    </div>
                    <a class="pt-magnet" href={`${links.core}/tree/main/examples/interaction`} data-magnet>
                      <span>{t.next.magnet} <span aria-hidden="true">↗</span></span>
                    </a>
                  </>
                )}
                {panel.id === 'scramble' && (
                  <>
                    <div class="sc-lines">
                      {t.next.scrambleLines.map((line) => (
                        <p class="sc-line" lang={scriptLang(line)} dir={dirOf(scriptLang(line))}>
                          <span class="visually-hidden">{line}</span>
                          <span aria-hidden="true" data-scramble>{line}</span>
                        </p>
                      ))}
                    </div>
                    <button type="button" class="np-btn np-replay" data-scramble-replay>{t.next.replay}</button>
                  </>
                )}
                {panel.id === 'noise' && (
                  <>
                    <canvas class="nz-canvas" aria-hidden="true" data-noise />
                    <p class="nz-fallback" data-noise-fallback hidden>{t.next.noWebgl}</p>
                  </>
                )}
              </div>
              <div class="np-text">
                <h3 class="np-title">{panel.title}</h3>
                <p class="np-body">{panel.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="next-bar" aria-hidden="true"><i data-next-bar /></div>
    </div>
  </section>

  <div class="next-band" aria-hidden="true">
    <div class="next-marquee" data-marquee>
      <span class="nm-text">{t.next.marquee.split(' · ').map((part, j) => (j ? <><i>·</i>{part}</> : part))}</span>
    </div>
  </div>

  <section class="work" id="work">
    <header class="section-head">
      <p class="eyebrow">{t.work.kicker}</p>
    </header>
    <article class="case">
      <a class="case-visual" href={links.abali} aria-label={`${t.work.title} — ${t.work.cta}`}>
        <img src="/work/abali-hero.webp" alt="" width="1600" height="1000" loading="lazy" decoding="async" data-parallax />
        <span class="case-visual-fallback" aria-hidden="true"><span lang="fa">خنکی صدا دارد.</span></span>
      </a>
      <div class="case-text">
        <p class="case-no">{t.work.case}</p>
        <h2 class="case-title">{t.work.title}</h2>
        <p class="case-tagline"><bdi lang="fa" dir="rtl">«خنکی صدا دارد.»</bdi>{lang === 'fa' ? '' : <span class="case-tagline-en" lang={lang}> — {t.work.tagline}</span>}</p>
        <p class="case-body">{t.work.body}</p>
        <dl class="case-facts">
          {t.work.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <div class="case-ctas">
          <a class="btn btn-solid" href={links.abali}>{t.work.cta}<span aria-hidden="true"> ↗</span></a>
          <a class="btn btn-line" href={links.abaliRepo}>{t.work.source}<span aria-hidden="true"> ↗</span></a>
        </div>
        <p class="case-disclaimer">{t.work.disclaimer}</p>
      </div>
    </article>
  </section>

  <section class="studio" id="studio">
    <header class="section-head">
      <p class="eyebrow">{t.studio.kicker}</p>
      <h2 class="section-title">{t.studio.title}</h2>
    </header>
    <ol class="parts">
      {
        t.studio.parts.map((part, i) => (
          <li class="part">
            <span class="part-no">{digits(String(i + 1).padStart(2, '0'))}</span>
            <h3 class="part-name">{part.name}</h3>
            <p class="part-body">{part.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="loop-diagram" aria-hidden="true">
      <svg viewBox="0 0 600 220" class="loop-svg">
        <path class="ld-path" d="M110 110 C 180 20, 420 20, 490 110 C 420 200, 180 200, 110 110 Z" />
        <circle class="ld-dot" r="5"><animateMotion dur="9s" repeatCount="indefinite" path="M110 110 C 180 20, 420 20, 490 110 C 420 200, 180 200, 110 110 Z" /></circle>
      </svg>
      <span class="ld-node ld-a">{t.studio.parts[0]!.name}</span>
      <span class="ld-node ld-b">{t.studio.parts[1]!.name}</span>
      <span class="ld-node ld-c">{t.studio.parts[2]!.name}</span>
    </div>
    <h3 class="principles-title">{t.studio.principlesTitle}</h3>
    <ul class="principles">
      {t.studio.principles.map((p) => <li><strong>{p.name}</strong><span>{p.body}</span></li>)}
    </ul>
  </section>

  <section class="start" id="start">
    <div class="start-text">
      <p class="eyebrow">{t.start.kicker}</p>
      <h2 class="section-title">{t.start.title}</h2>
      <p class="section-intro">{t.start.body}</p>
      <div class="hero-ctas">
        <a class="btn btn-solid btn-on-dark" href={links.core}>{t.start.cta}<span aria-hidden="true"> ↗</span></a>
        <a class="btn btn-line btn-on-dark" href={`${links.core}/blob/main/docs/guide.md`}>{t.start.docs}<span aria-hidden="true"> ↗</span></a>
      </div>
    </div>
    <pre class="code" dir="ltr" lang="en"><code>{code}</code></pre>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <header class="contact-head">
      <p class="eyebrow">{t.contact.kicker}</p>
      <h2 class="section-title" id="contact-title">{t.contact.title}</h2>
    </header>
    <div class="contact-text">
      <p class="contact-body">{t.contact.body}</p>
      <ul class="contact-offer">
        {t.contact.offer.map((item, i) => <li><span class="contact-no" aria-hidden="true">{two(i + 1)}</span>{item}</li>)}
      </ul>
    </div>
    <div class="contact-mail">
      <span class="contact-write">{t.contact.write}</span>
      <a class="contact-email" href={mail} lang="en" dir="ltr" translate="no" data-contact-email><span>{email}</span></a>
      <button type="button" class="btn btn-line contact-copy" data-copy={email} data-copied={t.contact.copied}>{t.contact.copy}</button>
      <span class="visually-hidden" role="status" data-copy-status></span>
    </div>
  </section>
</main>

<footer class="footer">
  <p class="footer-mark">{t.hero.wordmark}</p>
  <p class="footer-made">{t.footer.made}</p>
  <nav class="footer-links" aria-label={t.footer.links}>
    <a href={mail} class="footer-email" lang="en" dir="ltr" translate="no">{email}</a>
    <a href={links.core}>Veyra Core<span aria-hidden="true"> ↗</span></a>
    <a href={links.abali}>{t.work.title}<span aria-hidden="true"> ↗</span></a>
    <a href={links.org}>GitHub<span aria-hidden="true"> ↗</span></a>
    {others.map((l) => <a href={paths[l]} hreflang={l} lang={l} data-lang-switch={l}>{content[l].langName}</a>)}
  </nav>
  <p class="footer-rights">{t.footer.rights}</p>
  <a class="footer-top" href="#top">{t.footer.top} <span aria-hidden="true">↑</span></a>
</footer>

{
  others.map((l) => (
    <div class="lang-hint" data-lang-hint={l} hidden lang={l} dir={dirOf(l)}>
      <a href={paths[l]} hreflang={l} data-lang-switch={l}>{content[l].langHint} {arrowFor(l)}</a>
      <button type="button" data-lang-hint-close aria-label={content[l].close}>×</button>
    </div>
  ))
}
